root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{py,pyi}]
indent_size = 4

# scripts/winctl.c and its tests: four spaces, as scripts/.clang-format (Microsoft-based) formats them.
[*.{c,h}]
indent_size = 4
tab_width = 4

[{Makefile,*.mk,*.go}]
indent_style = tab
